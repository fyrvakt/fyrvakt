{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lcontreras48/kubit/blob/main/schemas/compatibility-evidence-feed-v1.schema.json",
  "title": "Kubit compatibility evidence feed v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "feed_revision",
    "generated_at",
    "expires_at",
    "providers"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "feed_revision": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "generated_at": { "$ref": "#/$defs/timestamp" },
    "expires_at": { "$ref": "#/$defs/timestamp" },
    "providers": {
      "type": "array",
      "items": { "$ref": "#/$defs/provider" }
    }
  },
  "$defs": {
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "httpsUrl": {
      "type": "string",
      "pattern": "^https://"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requested_url",
        "resolved_url",
        "media_type",
        "sha256"
      ],
      "properties": {
        "requested_url": { "$ref": "#/$defs/httpsUrl" },
        "resolved_url": { "$ref": "#/$defs/httpsUrl" },
        "revision": { "type": "string", "minLength": 1 },
        "media_type": { "type": "string", "minLength": 1 },
        "etag": { "type": "string", "minLength": 1 },
        "last_modified": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "rule": {
      "type": "object",
      "required": ["id", "type", "evidence"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "minLength": 1 },
        "evidence": { "$ref": "#/$defs/httpsUrl" }
      }
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "parser_version",
        "retrieved_at",
        "source",
        "rules"
      ],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "parser_version": { "type": "string", "minLength": 1 },
        "retrieved_at": { "$ref": "#/$defs/timestamp" },
        "source": { "$ref": "#/$defs/source" },
        "rules": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/rule" }
        }
      }
    }
  }
}
